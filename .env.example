OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Optional additional Gemini keys. Add or remove numbered entries as needed;
# the runner tries each key after a Gemini quota response before using another provider.
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GROQ_API_KEY=
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-3.6-flash
# Comma-separated provider:model routes tried after an HTTP 429, model
# unavailability, or when the preceding route exhausts MAX_ITERATIONS. Gemini
# entries use its free tier; :free entries are OpenRouter free variants. Free
# capacity and rate limits vary, and routes without a corresponding API key are
# skipped. Gemini routes use every configured Gemini key before non-Gemini
# routes are tried. A replacement route receives the current evidence and handoff brief.
MODEL_ROTATION=gemini:gemini-3.6-flash,gemini:gemini-3.5-flash,gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite,gemini:gemini-2.5-flash,gemini:gemini-2.5-flash-lite,groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,openrouter:poolside/laguna-s-2.1:free,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free,openrouter:inclusionai/ling-3.0-flash:free,openrouter:openai/gpt-oss-20b:free,openrouter:openrouter/free

# Model-response budget for each configured route.
MAX_ITERATIONS=20
COMMAND_TIMEOUT_SECONDS=60
CHALLENGE_TIMEOUT_SECONDS=600
MAX_SANDBOX_EXPANSIONS=1
# Set false when the challenge has no conventional flag wrapper.
HAS_FLAG_FORMAT=true
FLAG_FORMAT_REGEX=UCSI26\{[A-Za-z0-9_]+\}
