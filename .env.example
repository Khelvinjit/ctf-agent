OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-3.6-flash
# Comma-separated provider:model routes tried after an HTTP 429. Routes without
# a corresponding API key are skipped.
MODEL_ROTATION=gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b,openrouter:openrouter/free

MAX_ITERATIONS=15
COMMAND_TIMEOUT_SECONDS=60
CHALLENGE_TIMEOUT_SECONDS=600
MAX_SANDBOX_EXPANSIONS=1
FLAG_FORMAT_REGEX=picoCTF\{[^}\n]+\}
