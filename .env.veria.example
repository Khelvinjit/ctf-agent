# Configuration for integrations/verialabs-ctf-agent.
# Copy to .env.veria, fill the values, then source it before running
# scripts/run_veria_ctf_agent.sh. Keep it separate from this project's .env
# because the two agents use different model and CTFd settings.

CTFD_URL=https://ctf.example.com
CTFD_TOKEN=

# Provide credentials for the model providers you intend to use. The upstream
# defaults use authenticated Codex and Claude CLIs; API-backed model specs may
# instead require one of the provider-specific keys below.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional API-backed fallback configuration supported by the upstream agent.
AWS_REGION=us-east-1
AWS_BEARER_TOKEN=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENCODE_ZEN_API_KEY=

# Override when a non-default Docker image name is required.
# VERIA_SANDBOX_IMAGE=ctf-sandbox
